# OnePlus 15 / Android 16 / kernel 6.12 custom Kconfig fragment
#
# Edit this file directly in GitHub. It is merged into out/.config after
# gki_defconfig and the repository build defaults, then olddefconfig resolves
# dependencies.
#
# Supported forms:
#   CONFIG_EXAMPLE=y
#   CONFIG_EXAMPLE=m
#   CONFIG_NUMBER=123
#   CONFIG_TEXT="value"
#   # CONFIG_EXAMPLE is not set
#
# Do not set CONFIG_LOCALVERSION or CONFIG_LOCALVERSION_AUTO here.
# Kernel release is forced to:
#   6.12.23-android16-5-o-geb065695cf38-4k

# Add your custom options below.

# CONFIG_RCU_LAZY is not set
# SYSTEM_DATA_VERIFICATION is a hidden/derived symbol.  Keep module signature
# enforcement disabled, but select system-data verification through dm-verity.

CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
# CONFIG_CPU_FREQ_GOV_POWERSAVE is not set
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BIC=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_TCP_CONG_HSTCP=y
CONFIG_TCP_CONG_HYBLA=y
CONFIG_TCP_CONG_VEGAS=y
CONFIG_TCP_CONG_NV=y
CONFIG_TCP_CONG_SCALABLE=y
CONFIG_TCP_CONG_LP=y
CONFIG_TCP_CONG_VENO=y
CONFIG_TCP_CONG_YEAH=y
CONFIG_TCP_CONG_ILLINOIS=y
CONFIG_TCP_CONG_DCTCP=y
CONFIG_TCP_CONG_CDG=y
CONFIG_TCP_CONG_BBR=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_64BIT_CLUSTER=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_FAT_DEFAULT_UTF8=y
# CONFIG_MODVERSIONS is not set
