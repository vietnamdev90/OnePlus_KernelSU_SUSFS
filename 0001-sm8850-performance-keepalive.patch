From: OnePlus 15 local performance patch <local@localhost>
Date: Fri, 7 Aug 2026 21:30:22 +0700
Subject: [PATCH] SM8850: unlock CPU policy and cached-app execution

Disable OPlus' frequency bouncing ceilings and WALT core_ctl CPU pauses.
Ignore CPU cgroup caps used to deprioritize background work, and reject new
cgroup freezer requests while preserving thaw. Hardware thermal and cpufreq
cooling paths are intentionally untouched.

All behavior is boot-reversible through read-only core/module parameters.

---
 kernel/cgroup/cgroup.c       | 15 ++++++++
 kernel/sched/core.c          | 43 +++++++++++++++++++++

 2 files changed, 58 insertions(+), 2 deletions(-)

--- a/kernel/cgroup/cgroup.c
+++ b/kernel/cgroup/cgroup.c
@@ -36,6 +36,7 @@
 #include <linux/init_task.h>
 #include <linux/kernel.h>
 #include <linux/magic.h>
+#include <linux/moduleparam.h>
 #include <linux/mutex.h>
 #include <linux/mount.h>
 #include <linux/pagemap.h>
@@ -103,6 +104,17 @@
 static bool cgroup_debug __read_mostly;
 
 /*
+ * Android's cached-app freezer writes 1 to cgroup.freeze.  Keep thaw writes
+ * working so an already-frozen group can always recover, but reject new
+ * freezes when the performance profile is selected.  The stock behaviour can
+ * be restored with oplus_perf_disable_cgroup_freezer=0 on the kernel command
+ * line.
+ */
+static bool oplus_perf_disable_cgroup_freezer __read_mostly = true;
+core_param(oplus_perf_disable_cgroup_freezer,
+	   oplus_perf_disable_cgroup_freezer, bool, 0444);
+
+/*
  * Protects cgroup_idr and css_idr so that IDs can be released without
  * grabbing cgroup_mutex.
  */
@@ -4030,6 +4042,9 @@
 	if (freeze < 0 || freeze > 1)
 		return -ERANGE;
 
+	if (freeze && oplus_perf_disable_cgroup_freezer)
+		return -EOPNOTSUPP;
+
 	cgrp = cgroup_kn_lock_live(of->kn, false);
 	if (!cgrp)
 		return -ENOENT;
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -51,6 +51,7 @@
 #include <linux/llist_api.h>
 #include <linux/mmu_context.h>
 #include <linux/mmzone.h>
+#include <linux/moduleparam.h>
 #include <linux/mutex_api.h>
 #include <linux/nmi.h>
 #include <linux/nospec.h>
@@ -134,6 +135,16 @@
 DEFINE_PER_CPU_SHARED_ALIGNED(struct rq, runqueues);
 EXPORT_SYMBOL_GPL(runqueues);
 
+/*
+ * Remove CPU cgroup throttles in the performance profile while retaining
+ * higher-than-default boosts.  This covers low weights, SCHED_IDLE groups and
+ * finite CFS bandwidth quotas.  Pass oplus_perf_ignore_cpu_cgroup_limits=0 to
+ * restore stock behaviour.
+ */
+static bool oplus_perf_ignore_cpu_cgroup_limits __read_mostly = true;
+core_param(oplus_perf_ignore_cpu_cgroup_limits,
+	   oplus_perf_ignore_cpu_cgroup_limits, bool, 0444);
+
 #ifdef CONFIG_SCHED_PROXY_EXEC
 DEFINE_STATIC_KEY_FALSE(__sched_proxy_exec);
 static int __init setup_proxy_exec(char *str)
@@ -1468,6 +1479,15 @@
  */
 static DEFINE_MUTEX(uclamp_mutex);
 
+/*
+ * Ignore task and cgroup UCLAMP_MAX ceilings in the performance profile.
+ * UCLAMP_MIN remains untouched and hardware thermal/cpufreq limits continue
+ * to apply.  Pass oplus_perf_ignore_uclamp_max=0 to restore stock behaviour.
+ */
+static bool oplus_perf_ignore_uclamp_max __read_mostly = true;
+core_param(oplus_perf_ignore_uclamp_max,
+	   oplus_perf_ignore_uclamp_max, bool, 0444);
+
 /* Max allowed minimum utilization */
 static unsigned int __maybe_unused sysctl_sched_uclamp_util_min = SCHED_CAPACITY_SCALE;
 
@@ -1634,6 +1654,11 @@
 	int ret = 0;
 
 	trace_android_rvh_uclamp_eff_get(p, clamp_id, &uc_max, &uc_eff, &ret);
+	if (clamp_id == UCLAMP_MAX && oplus_perf_ignore_uclamp_max) {
+		uclamp_se_set(&uc_req, SCHED_CAPACITY_SCALE, false);
+		return uc_req;
+	}
+
 	if (ret)
 		return uc_eff;
 
@@ -10377,6 +10402,10 @@
 {
 	int ret;
 
+	if (oplus_perf_ignore_cpu_cgroup_limits)
+		shareval = max_t(u64, shareval,
+				 scale_load_down(NICE_0_LOAD));
+
 	if (shareval > scale_load_down(ULONG_MAX))
 		shareval = MAX_SHARES;
 	ret = sched_group_set_shares(css_tg(css), scale_load(shareval));
@@ -10412,6 +10441,11 @@
 	if (tg == &root_task_group)
 		return -EINVAL;
 
+	if (oplus_perf_ignore_cpu_cgroup_limits) {
+		quota = RUNTIME_INF;
+		burst = 0;
+	}
+
 	/*
 	 * Ensure we have at some amount of bandwidth every period.  This is
 	 * to prevent reaching a state of large arrears when throttled via
@@ -10776,6 +10810,9 @@
 {
 	int ret;
 
+	if (oplus_perf_ignore_cpu_cgroup_limits && idle > 0)
+		idle = 0;
+
 	ret = sched_group_set_idle(css_tg(css), idle);
 	if (!ret)
 		scx_group_set_idle(css_tg(css), idle);
@@ -10917,6 +10954,9 @@
 	if (cgrp_weight < CGROUP_WEIGHT_MIN || cgrp_weight > CGROUP_WEIGHT_MAX)
 		return -ERANGE;
 
+	if (oplus_perf_ignore_cpu_cgroup_limits)
+		cgrp_weight = max_t(u64, cgrp_weight, CGROUP_WEIGHT_DFL);
+
 	weight = sched_weight_from_cgroup(cgrp_weight);
 
 	ret = sched_group_set_shares(css_tg(css), scale_load(weight));
@@ -10952,6 +10992,9 @@
 	if (nice < MIN_NICE || nice > MAX_NICE)
 		return -ERANGE;
 
+	if (oplus_perf_ignore_cpu_cgroup_limits && nice > 0)
+		nice = 0;
+
 	idx = NICE_TO_PRIO(nice) - MAX_RT_PRIO;
 	idx = array_index_nospec(idx, 40);
 	weight = sched_prio_to_weight[idx];

-- 
2.43.0
